# ================= Elyther SMP SHOP SYSTEM =================

options:

# <GUI TITLE>
	mainshop_title: SHOP
	endshop_title: SHOP - END
	nethershop_title: SHOP - NETHER
	gearshop_title: SHOP - GEAR
	foodshop_title: SHOP - FOOD
	pvpshop_title: SHOP - PVP
	farmshop_title: SHOP - FARM

# <TEXT NOTIFICATION>
	purchase_successful_text: "&fYou purchased &f<#00a4fc>%{_amount}%x %{_itemName}% &ffor: <#00fc00>$%{_formattedPrice}%"
	not_enough_money_text: "&cYou don't have enough money."
	inventory_full_text: "&cYour inventory is full."
	
# <SOUNDS>
	purchase_successful_sound: ENTITY.EXPERIENCE_ORB.PICKUP
	purchase_successful_sound_volume: 0.5
	
	purchase_unsuccessful_sound: ENTITY.VILLAGER.NO
	purchase_unsuccessful_sound_volume: 0.5
	
	click_sound: UI.BUTTON.CLICK
	click_sound_volume: 0.5
	
# <PRICES>
#		<END CATEGORY>
	Enderchest_price: 2500 
	end.Enderpearl_price: 75
	Endstone_price: 8
	Dragonbreath_price: 1000 
	Endrod_price: 100
	Chorusfruit_price: 10
	PoppedChorusfruit_price: 15
	Shulkershell_price: 350
	Shulkerbox_price: 800
	
#		<NETHER CATEGORY>
	Blazerod_price: 150
	Netherwart_price: 15
	Glowstonedust_price: 15
	Magmacream_price: 15
	Ghasttear_price: 350
	Quartz_price: 15
	Soulsand_price: 50
	Magmablock_price: 35
	Cryingobsidian_price: 150
	
#		<GEAR CATEGORY>	
	Obsidian_price: 100
	Endcrystal_price: 350
	Respawnanchor_price: 1000 
	Glowstone_price: 100
	Totemofundying_price: 1250 
	gear.Enderpearl_price: 75
	gear.Goldenapple_price: 250
	Bottleo'enchanting_price: 100
	Arrow_price: 250
	
#		<FOOD CATEGORY>
	Potato_price: 75
	Sweetberries_price: 50
	Melonslice_price: 10 
	Carrot_price: 65
	Apple_price: 25
	Cookedchicken_price: 30
	Steak_price: 35
	Goldencarrot_price: 50
	food.Goldenapple_price: 250

#		<PVP CATEGORY>
	Diamondhelmet_price: 2500
	Diamondchestplate_price: 3500
	Diamondleggings_price: 3000
	Diamondboots_price: 2000
	Diamondsword_price: 2000

#		<FARM CATEGORY>
	Piston_price: 150
	Stickypiston_price: 200
	Redstonedust_price: 10
	Redstoneblock_price: 90
	Noteblock_price: 50
	Redstonetorch_price: 15
	Tripwirehook_price: 25
	Hopper_price: 250
	Chest_price: 50
	Repeater_price: 50
	Comparator_price: 75
	
# --------------QUICK BUY SYSTEM----------------

function doQuickBuy(p: player, item: item, price: int, amount: int):
	set {_totalCost} to {_amount} * {_price}
	if {_p} doesn't have enough space for {_amount} of {_item}:
		send {@inventory_full_text} to {_p}
		send action bar {@inventory_full_text} to {_p}
		play sound "{@purchase_unsuccessful_sound}" at volume {@purchase_unsuccessful_sound_volume} to {_p}
		stop
	if {_p}'s balance is less than {_totalCost}:
		send {@not_enough_money_text} to {_p}
		send action bar {@not_enough_money_text} to {_p}
		play sound "{@purchase_unsuccessful_sound}" at volume {@purchase_unsuccessful_sound_volume} to {_p}
		stop
	give {_p} {_amount} of {_item}
	remove {_totalCost} from {_p}'s balance
	set {_formattedPrice} to a("%{_totalCost}%")
	set {_itemName} to proper case "%type of {_item}%"
	send {@purchase_successful_text} to {_p}
	send action bar {@purchase_successful_text} to {_p}
	play sound "{@purchase_successful_sound}" at volume {@purchase_successful_sound_volume} to {_p}

function processClick(p: player, item: item, price: int, category: string, amount: int, isQuick: boolean):
	set {n.%{_p}%} to {_amount}
	if {_isQuick} is true:
		doQuickBuy({_p}, {_item}, {_price}, {_amount})
	else:
		play sound "{@click_sound}" at volume {@click_sound_volume} to {_p}
		buy({_p}, {_item}, {_price}, {_category})

# --------------MAIN SHOP----------------

command /shop:
	trigger:
		openShop(player)
		
function openShop(p: player):
	set {_inv} to a new chest inventory with 3 row with name "{@mainshop_title}"
	set slot 15 of {_inv} to end stone named "<#00F986>ᴇɴᴅ" with lore "&fClick to view the End shop"
	set slot 11 of {_inv} to netherrack named "<#00F986>ɴᴇᴛʜᴇʀ" with lore "&fClick to view the Nether shop"
	set slot 13 of {_inv} to totem of undying named "<#00F986>ɢᴇᴀʀ" with lore "&fClick to view the Gear shop"
	set slot 12 of {_inv} to cooked beef named "<#00F986>ꜰᴏᴏᴅ" with lore "&fClick to view the Food shop"
	set slot 14 of {_inv} to amethyst shard named "<#A303F9>ᴄʀʏꜱᴛᴀʟ ꜱʜᴏᴘ" with lore "&fClick to open the Crystal shop"
	set slot 4 of {_inv} to diamond chestplate named "<#00F986>ᴘᴠᴘ" with lore "&fClick to view the PvP shop"
	set slot 22 of {_inv} to piston named "<#00F986>ꜰᴀʀᴍ" with lore "&fClick to view the Farm shop"
	open {_inv} to {_p}

on inventory click:
	if name of event-inventory is "{@mainshop_title}":
		if clicked inventory isn't player's inventory:
			cancel event
			if index of event-slot = 4:
				openPvpShop(player)
				play sound "{@click_sound}" at volume {@click_sound_volume} to player
			if index of event-slot = 11:
				openNetherShop(player)
				play sound "{@click_sound}" at volume {@click_sound_volume} to player
			if index of event-slot = 12:
				openFoodShop(player)
				play sound "{@click_sound}" at volume {@click_sound_volume} to player
			if index of event-slot = 13:
				openGearShop(player)
				play sound "{@click_sound}" at volume {@click_sound_volume} to player
			if index of event-slot = 14:
				player command "/kristal"
				play sound "{@click_sound}" at volume {@click_sound_volume} to player
			if index of event-slot = 15:
				openEndShop(player)
				play sound "{@click_sound}" at volume {@click_sound_volume} to player
			if index of event-slot = 22:
				openFarmShop(player)
				play sound "{@click_sound}" at volume {@click_sound_volume} to player
		else if click type is left mouse button with shift or right mouse button with shift:
			cancel event
		
# --------------END SHOP----------------

function openEndShop(p: player):
	set {_inv} to a new chest inventory with 3 row with name "{@endshop_title}"
	set slot 18 of {_inv} to red stained glass pane named "<#fd0100>ʙᴀᴄᴋ" with lore "&fClick to go back"
	set slot 9 of {_inv} to ender chest with lore "&fBuy Price: <#4FF750>$2,500" and "&a▸ Right Click to Quick Buy"
	set slot 10 of {_inv} to ender pearl with lore "&fBuy Price: <#4FF750>${@gear.Enderpearl_price}" and "&a▸ Right Click to Quick Buy"
	set slot 11 of {_inv} to 16 of end stone with lore "&fBuy Price: <#4FF750>${@Endstone_price}" and "&a▸ Right Click to Quick Buy"
	set slot 12 of {_inv} to dragon breath with lore "&fBuy Price: <#4FF750>$1,000" and "&a▸ Right Click to Quick Buy"
	set slot 13 of {_inv} to end rod with lore "&fBuy Price: <#4FF750>${@Endrod_price}" and "&a▸ Right Click to Quick Buy"
	set slot 14 of {_inv} to chorus fruit with lore "&fBuy Price: <#4FF750>${@Chorusfruit_price}" and "&a▸ Right Click to Quick Buy"
	set slot 15 of {_inv} to popped chorus fruit with lore "&fBuy Price: <#4FF750>${@PoppedChorusfruit_price}" and "&a▸ Right Click to Quick Buy"
	set slot 16 of {_inv} to shulker shell with lore "&fBuy Price: <#4FF750>${@Shulkershell_price}" and "&a▸ Right Click to Quick Buy"
	set slot 17 of {_inv} to shulker box with lore "&fBuy Price: <#4FF750>${@Shulkerbox_price}" and "&a▸ Right Click to Quick Buy"
	open {_inv} to {_p}
			
on inventory click:
	if name of event-inventory is "{@endshop_title}":
		if clicked inventory isn't player's inventory:
			cancel event
			set {_q} to false
			if click type is right mouse button or right mouse button with shift or left mouse button with shift:
				set {_q} to true
				
			if index of event-slot = 18:
				player command "/shop"
				play sound "{@click_sound}" at volume {@click_sound_volume} to player
			if index of event-slot = 9:
				processClick(player, Ender Chest, {@Enderchest_price}, "End", 1, {_q})
			if index of event-slot = 10:
				processClick(player, Ender Pearl, {@gear.Enderpearl_price}, "End", 1, {_q})
			if index of event-slot = 11:
				processClick(player, End Stone, {@Endstone_price}, "End", 16, {_q})
			if index of event-slot = 12:
				processClick(player, Dragon Breath, {@Dragonbreath_price}, "End", 1, {_q})
			if index of event-slot = 13:
				processClick(player, End Rod, {@Endrod_price}, "End", 1, {_q})
			if index of event-slot = 14:
				processClick(player, Chorus Fruit, {@Chorusfruit_price}, "End", 1, {_q})
			if index of event-slot = 15:
				processClick(player, Popped Chorus Fruit, {@PoppedChorusfruit_price}, "End", 1, {_q})
			if index of event-slot = 16:
				processClick(player, Shulker Shell, {@Shulkershell_price}, "End", 1, {_q})
			if index of event-slot = 17:
				processClick(player, Shulker Box, {@Shulkerbox_price}, "End", 1, {_q})
		else if click type is left mouse button with shift or right mouse button with shift:
			cancel event

