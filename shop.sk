# --------------PVP SHOP---------------- 

function getPvpItem(type: text) :: item:
	if {_type} is "helmet":
		set {_item} to diamond helmet
		enchant {_item} with protection 4
		enchant {_item} with unbreaking 3
		enchant {_item} with mending 1
		return {_item}
	else if {_type} is "chestplate":
		set {_item} to diamond chestplate
		enchant {_item} with protection 4
		enchant {_item} with unbreaking 3
		enchant {_item} with mending 1
		return {_item}
	else if {_type} is "leggings":
		set {_item} to diamond leggings
		enchant {_item} with protection 4
		enchant {_item} with unbreaking 3
		enchant {_item} with mending 1
		return {_item}
	else if {_type} is "boots":
		set {_item} to diamond boots
		enchant {_item} with protection 4
		enchant {_item} with unbreaking 3
		enchant {_item} with mending 1
		return {_item}
	else if {_type} is "sword":
		set {_item} to diamond sword
		enchant {_item} with sharpness 3
		enchant {_item} with unbreaking 3
		enchant {_item} with mending 1
		return {_item}

function openPvpShop(p: player):
	set {_inv} to a new chest inventory with 3 row with name "{@pvpshop_title}"
	set slot 18 of {_inv} to red stained glass pane named "<#fd0100>ʙᴀᴄᴋ" with lore "&fClick to go back"
	
	set {_helmet} to getPvpItem("helmet")
	set {_chestplate} to getPvpItem("chestplate")
	set {_leggings} to getPvpItem("leggings")
	set {_boots} to getPvpItem("boots")
	set {_sword} to getPvpItem("sword")
	
	set slot 11 of {_inv} to {_helmet} with lore "&fBuy Price: <#4FF750>${@Diamondhelmet_price}" and "&a▸ Right Click to Quick Buy"
	set slot 12 of {_inv} to {_chestplate} with lore "&fBuy Price: <#4FF750>${@Diamondchestplate_price}" and "&a▸ Right Click to Quick Buy"
	set slot 13 of {_inv} to {_leggings} with lore "&fBuy Price: <#4FF750>${@Diamondleggings_price}" and "&a▸ Right Click to Quick Buy"
	set slot 14 of {_inv} to {_boots} with lore "&fBuy Price: <#4FF750>${@Diamondboots_price}" and "&a▸ Right Click to Quick Buy"
	set slot 15 of {_inv} to {_sword} with lore "&fBuy Price: <#4FF750>${@Diamondsword_price}" and "&a▸ Right Click to Quick Buy"
	
	open {_inv} to {_p}

on inventory click:
	if name of event-inventory is "{@pvpshop_title}":
		if clicked inventory isn't player's inventory:
			cancel event
			set {_q} to false
			if click type is right mouse button or right mouse button with shift or left mouse button with shift:
				set {_q} to true
				
			if index of event-slot = 18:
				player command "/shop"
				play sound "{@click_sound}" at volume {@click_sound_volume} to player
			if index of event-slot = 11:
				processClick(player, getPvpItem("helmet"), {@Diamondhelmet_price}, "PvP", 1, {_q})
			if index of event-slot = 12:
				processClick(player, getPvpItem("chestplate"), {@Diamondchestplate_price}, "PvP", 1, {_q})
			if index of event-slot = 13:
				processClick(player, getPvpItem("leggings"), {@Diamondleggings_price}, "PvP", 1, {_q})
			if index of event-slot = 14:
				processClick(player, getPvpItem("boots"), {@Diamondboots_price}, "PvP", 1, {_q})
			if index of event-slot = 15:
				processClick(player, getPvpItem("sword"), {@Diamondsword_price}, "PvP", 1, {_q})
		else if click type is left mouse button with shift or right mouse button with shift:
			cancel event

# --------------FARM SHOP---------------- 

function openFarmShop(p: player):
	set {_inv} to a new chest inventory with 3 row with name "{@farmshop_title}"
	set slot 18 of {_inv} to red stained glass pane named "<#fd0100>ʙᴀᴄᴋ" with lore "&fClick to go back"
	
	set slot 2 of {_inv} to piston with lore "&fBuy Price: <#4FF750>${@Piston_price}" and "&a▸ Right Click to Quick Buy"
	set slot 3 of {_inv} to sticky piston with lore "&fBuy Price: <#4FF750>${@Stickypiston_price}" and "&a▸ Right Click to Quick Buy"
	set slot 4 of {_inv} to redstone with lore "&fBuy Price: <#4FF750>${@Redstonedust_price}" and "&a▸ Right Click to Quick Buy"
	set slot 5 of {_inv} to redstone block with lore "&fBuy Price: <#4FF750>${@Redstoneblock_price}" and "&a▸ Right Click to Quick Buy"
	set slot 6 of {_inv} to note block with lore "&fBuy Price: <#4FF750>${@Noteblock_price}" and "&a▸ Right Click to Quick Buy"
	
	set slot 11 of {_inv} to redstone torch with lore "&fBuy Price: <#4FF750>${@Redstonetorch_price}" and "&a▸ Right Click to Quick Buy"
	set slot 12 of {_inv} to tripwire hook with lore "&fBuy Price: <#4FF750>${@Tripwirehook_price}" and "&a▸ Right Click to Quick Buy"
	set slot 13 of {_inv} to hopper with lore "&fBuy Price: <#4FF750>${@Hopper_price}" and "&a▸ Right Click to Quick Buy"
	set slot 14 of {_inv} to chest with lore "&fBuy Price: <#4FF750>${@Chest_price}" and "&a▸ Right Click to Quick Buy"
	set slot 15 of {_inv} to repeater with lore "&fBuy Price: <#4FF750>${@Repeater_price}" and "&a▸ Right Click to Quick Buy"
	set slot 16 of {_inv} to comparator with lore "&fBuy Price: <#4FF750>${@Comparator_price}" and "&a▸ Right Click to Quick Buy"
	
	open {_inv} to {_p}

on inventory click:
	if name of event-inventory is "{@farmshop_title}":
		if clicked inventory isn't player's inventory:
			cancel event
			set {_q} to false
			if click type is right mouse button or right mouse button with shift or left mouse button with shift:
				set {_q} to true
				
			if index of event-slot = 18:
				player command "/shop"
				play sound "{@click_sound}" at volume {@click_sound_volume} to player
			if index of event-slot = 2:
				processClick(player, Piston, {@Piston_price}, "Farm", 1, {_q})
			if index of event-slot = 3:
				processClick(player, Sticky Piston, {@Stickypiston_price}, "Farm", 1, {_q})
			if index of event-slot = 4:
				processClick(player, Redstone Dust, {@Redstonedust_price}, "Farm", 1, {_q})
			if index of event-slot = 5:
				processClick(player, Redstone Block, {@Redstoneblock_price}, "Farm", 1, {_q})
			if index of event-slot = 6:
				processClick(player, Note Block, {@Noteblock_price}, "Farm", 1, {_q})
			if index of event-slot = 11:
				processClick(player, Redstone Torch, {@Redstonetorch_price}, "Farm", 1, {_q})
			if index of event-slot = 12:
				processClick(player, Tripwire Hook, {@Tripwirehook_price}, "Farm", 1, {_q})
			if index of event-slot = 13:
				processClick(player, Hopper, {@Hopper_price}, "Farm", 1, {_q})
			if index of event-slot = 14:
				processClick(player, Chest, {@Chest_price}, "Farm", 1, {_q})
			if index of event-slot = 15:
				processClick(player, Repeater, {@Repeater_price}, "Farm", 1, {_q})
			if index of event-slot = 16:
				processClick(player, Comparator, {@Comparator_price}, "Farm", 1, {_q})
		else if click type is left mouse button with shift or right mouse button with shift:
			cancel event
						
# --------------BUY GUI---------------- 

function formatSmallCaps(input: text) :: text:
    set {_text} to {_input}
    set {_smallcaps::*} to "ᴀʙᴄᴅᴇꜰɢʜɪᴊᴋʟᴍɴᴏᴘqʀꜱᴛᴜᴠᴡxʏᴢ" split at ""
    set {_normal::*} to "abcdefghijklmnopqrstuvwxyz" split at ""
    loop {_normal::*}:
        replace all "%loop-value%" with "%{_smallcaps::%loop-index%}%" in {_text}
    return {_text}
    
function a(b: text) :: text:
  if length of {_b} > 3:
    return "%a(first length of {_b} - 3 characters of {_b})%,%last 3 characters of {_b}%"
  return {_b}
  
function buy(p: player, item: item, price: int, category: string): 
	if {n.%{_p}%} is not set:
		set {n.%{_p}%} to 1
	set {_qty} to {n.%{_p}%}
	set {_max} to max stack size of {_item}

	set {_itemName} to formatSmallCaps("%type of {_item}%")
	set {_inv} to a new chest inventory with 3 row named "BUYING: %{_itemName}%"
	set {_priceText} to "%{_qty} * {_price}%"
	set slot 13 of {_inv} to {_qty} of {_item} with lore "&fBuy Price: <#4FF750>$%a({_priceText})%"

	if {_max} > 1:
		if {_qty} > 1:
			set slot 9 of {_inv} to {_max} of red stained glass pane named "&cRemove % {_max}%"
			set slot 11 of {_inv} to red stained glass pane named "&cRemove 1"
		if {_qty} > 10:
			set slot 10 of {_inv} to 10 of red stained glass pane named "&cRemove 10"
		if {_qty} < {_max}:
			set slot 15 of {_inv} to lime stained glass pane named "&aAdd 1"
			set slot 17 of {_inv} to {_max} of lime stained glass pane named "&aSet to % {_max}%"
			set {_leftToMax} to {_max} - {_qty}
			if {_leftToMax} >= 10:
				set slot 16 of {_inv} to 10 of lime stained glass pane named "&aAdd 10"
			else:
				set slot 16 of {_inv} to air
	else:
		set slot 9, 10, 11, 15, 16, 17 of {_inv} to air

	set slot 21 of {_inv} to red stained glass pane named "<#fd0100>ᴄᴀɴᴄᴇʟ" with lore "&fClick to cancel"
	set slot 23 of {_inv} to lime stained glass pane named "<#01fc01>ᴄᴏɴꜰɪʀᴍ" with lore "&fClick to purchase" and "&a▸ Right Click to Buy Maximum"

	set {item.%{_p}%} to {_item}
	set {price.%{_p}%} to {_price}
	set {category.%{_p}%} to {_category}
	open {_inv} to {_p}

on inventory click:
	if name of event-inventory contains "BUYING:":
		if clicked inventory isn't player's inventory:
			cancel event
			set {_p} to player
			set {_item} to {item.%{_p}%}
			set {_maxStackSize} to max stack size of {_item}
			set {_guiname} to {guiname.%{_p}%}
			set {_price} to {price.%{_p}%}
			set {_category} to {category.%{_p}%}

			if {_maxStackSize} > 1:
				if {n.%{_p}%} > 1:
					if index of event-slot = 11:
						remove 1 from {n.%{_p}%}
						play sound "{@click_sound}" at volume {@click_sound_volume} to {_p}
						buy({_p}, {_item}, {_price}, {_category})
					if index of event-slot = 9:
						set {n.%{_p}%} to 1
						play sound "{@click_sound}" at volume {@click_sound_volume} to {_p}
						buy({_p}, {_item}, {_price}, {_category})

				if {n.%{_p}%} > 10:
					if index of event-slot = 10:
						remove 10 from {n.%{_p}%}
						play sound "{@click_sound}" at volume {@click_sound_volume} to {_p}
						buy({_p}, {_item}, {_price}, {_category})

				if {n.%{_p}%} < {_maxStackSize}:
					if index of event-slot = 15:
						add 1 to {n.%{_p}%}
						play sound "{@click_sound}" at volume {@click_sound_volume} to {_p}
						buy({_p}, {_item}, {_price}, {_category})

					if index of event-slot = 17:
						set {n.%{_p}%} to {_maxStackSize}
						play sound "{@click_sound}" at volume {@click_sound_volume} to {_p}
						buy({_p}, {_item}, {_price}, {_category})

				set {_maxAdd10} to {_maxStackSize} - {n.%{_p}%}
				if {_maxAdd10} >= 10:
					if index of event-slot = 16:
						add 10 to {n.%{_p}%}
						play sound "{@click_sound}" at volume {@click_sound_volume} to {_p}
						buy({_p}, {_item}, {_price}, {_category})
		else if click type is left mouse button with shift or right mouse button with shift:
			cancel event
						
	if name of event-inventory contains "BUYING:":
		if clicked inventory isn't player's inventory:					
			cancel event
			if index of event-slot = 23:
				set {_p} to player
				set {_item} to {item.%{_p}%}
				set {_price} to {price.%{_p}%}
				set {_category} to {category.%{_p}%}
				set {_guiname} to {guiname.%{_p}%}
				
				if click type is right mouse button or right mouse button with shift or left mouse button with shift:
					set {_amount} to max stack size of {_item}
				else:
					set {_amount} to {n.%{_p}%}
					
				set {_totalCost} to {_amount} * {_price}
				if player doesn't have enough space for {_amount} of {_item}:
					send {@inventory_full_text}
					send action bar {@inventory_full_text}
					play sound "{@purchase_unsuccessful_sound}" at volume {@purchase_unsuccessful_sound_volume} to player
					play sound "{@click_sound}" at volume {@click_sound_volume} to player
					buy({_p}, {_item}, {_price}, {_category})
				else:
					if player's balance is higher or equal to {_totalCost}:
						if {_item} is not air:
							give player {_amount} of {_item}
							remove {_totalCost} from player's balance
							set {_formattedPrice} to a("%{_totalCost}%")
							set {_itemName} to proper case "%type of {_item}%"
							send {@purchase_successful_text} to player
							send action bar {@purchase_successful_text} to player
							play sound "{@purchase_successful_sound}" at volume {@purchase_successful_sound_volume} to player
							play sound "{@click_sound}" at volume {@click_sound_volume} to player
							buy({_p}, {_item}, {_price}, {_category})
					else:
						send {@not_enough_money_text}
						send action bar {@not_enough_money_text}
						play sound "{@purchase_unsuccessful_sound}" at volume {@purchase_unsuccessful_sound_volume} to player
						play sound "{@click_sound}" at volume {@click_sound_volume} to player
						buy({_p}, {_item}, {_price}, {_category})
		else if click type is left mouse button with shift or right mouse button with shift:
			cancel event
					
	if name of event-inventory contains "BUYING:":
		if clicked inventory isn't player's inventory:
			cancel event
			if index of event-slot = 21:
				if {category.%player%} is "Nether":
					openNetherShop(player)
				else if {category.%player%} is "End":
					openEndShop(player)
				else if {category.%player%} is "Gear":
					openGearShop(player)
				else if {category.%player%} is "Food":
					openFoodShop(player)
				else if {category.%player%} is "PvP":
					openPvpShop(player)
				else if {category.%player%} is "Farm":
					openFarmShop(player)
				else:
					player command "/shop"
				play sound "{@click_sound}" at volume {@click_sound_volume} to player
		else if click type is left mouse button with shift or right mouse button with shift:
			cancel event